{
 "format": "han-timeline-vector/1",
 "name": "17-fork-isolates-timelines",
 "description": "A fork starts from a version of its source; work on either timeline does not appear on the other, and heads come from batch tags",
 "rules": [
  "TL-20",
  "TL-21",
  "TL-22",
  "TL-24"
 ],
 "replicas": {
  "A": [
   "@alice:a.example",
   "laptop",
   0
  ],
  "B": [
   "@bob:b.example",
   "desk",
   0
  ],
  "C": [
   "@alice:a.example",
   "phone",
   0
  ]
 },
 "batches": {
  "b0": {
   "replica": "A",
   "start": 1,
   "parents": [],
   "timeline": null,
   "ops": [
    {
     "kind": "timeline.create",
     "name": "main",
     "source": null,
     "historyKind": "data"
    },
    {
     "kind": "text.create",
     "text": "base\n",
     "transcript": false
    }
   ]
  },
  "fork": {
   "replica": "A",
   "start": 3,
   "parents": [
    "2@A"
   ],
   "timeline": null,
   "ops": [
    {
     "kind": "timeline.create",
     "name": "s1",
     "source": "1@A"
    }
   ]
  },
  "s1edit": {
   "replica": "B",
   "start": 4,
   "parents": [
    "3@A"
   ],
   "timeline": "3@A",
   "ops": [
    {
     "kind": "text.edit",
     "target": "2@A",
     "deletes": [],
     "inserts": [
      [
       "2@A#0:4",
       "more\n"
      ]
     ]
    }
   ]
  },
  "mainset": {
   "replica": "A",
   "start": 4,
   "parents": [
    "2@A"
   ],
   "timeline": "1@A",
   "ops": [
    {
     "kind": "map.set",
     "target": "root",
     "key": "k",
     "value": 1
    }
   ]
  }
 },
 "runs": [
  {
   "steps": [
    {
     "deliver": "b0"
    },
    {
     "deliver": "fork"
    },
    {
     "deliver": "s1edit"
    },
    {
     "deliver": "mainset"
    },
    {
     "expect": {
      "heads": {
       "1@A": [
        "4@A"
       ],
       "3@A": [
        "4@B"
       ]
      },
      "states": [
       {
        "at": "1@A",
        "objects": {
         "2@A": {
          "text": "base\n"
         },
         "root": {
          "entries": {
           "k": [
            [
             "4@A",
             1
            ]
           ]
          }
         }
        }
       },
       {
        "at": "3@A",
        "objects": {
         "2@A": {
          "text": "base\nmore\n"
         },
         "root": {
          "entries": {}
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "steps": [
    {
     "deliver": "b0"
    },
    {
     "deliver": "fork"
    },
    {
     "deliver": "mainset"
    },
    {
     "deliver": "s1edit"
    },
    {
     "expect": {
      "heads": {
       "1@A": [
        "4@A"
       ],
       "3@A": [
        "4@B"
       ]
      },
      "states": [
       {
        "at": "1@A",
        "objects": {
         "2@A": {
          "text": "base\n"
         },
         "root": {
          "entries": {
           "k": [
            [
             "4@A",
             1
            ]
           ]
          }
         }
        }
       },
       {
        "at": "3@A",
        "objects": {
         "2@A": {
          "text": "base\nmore\n"
         },
         "root": {
          "entries": {}
         }
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
