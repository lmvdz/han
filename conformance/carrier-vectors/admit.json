{
 "name": "admit",
 "rules": [
  "N-02",
  "G-07",
  "X9",
  "X12"
 ],
 "function": "admit(conn, spaces)",
 "description": "the peer filter: any node may say hello; nothing else before it; a node that vouches for its hello actor is admitted as server (a server actor) or member (a role holder in a space served here, its own profile included); anyone else only for join, cancel, reads of public, profile and not-held spaces, and appends to open-join spaces; `expect` compares allow and tier (the reason is informative)",
 "spaces": {
  "team:a.example": {
   "policy": {
    "visibility": "members",
    "join": "invite",
    "membersMayInvite": false,
    "allowAgents": "any",
    "approvals": [],
    "separateApprover": false,
    "budget": null,
    "maxDelegationDepth": 4,
    "minDurability": "local",
    "launchWindow": 30,
    "extensionsMinRole": "member",
    "sessions": {
     "watch": "member",
     "read": "member",
     "steer": "owner",
     "modes": [
      "auto",
      "guarded"
     ]
    },
    "servers": {
     "deny": []
    }
   },
   "roles": {
    "@alice:a.example": "owner",
    "@gone:a.example": "banned"
   }
  },
  "pub:a.example": {
   "policy": {
    "visibility": "public",
