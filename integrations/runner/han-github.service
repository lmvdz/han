[Unit]
Description=HAN GitHub integration (han-github); configured by hand (docs/runner.md 10), left disabled by `han runner setup`
After=network-online.target han-node.service
Wants=network-online.target han-node.service
# Not started until it is configured: the config names the read-only App and its key (docs/runner.md 10).
ConditionPathExists=/var/lib/han/github/han-github.toml
ConditionFileIsExecutable=/usr/local/bin/han-github

[Service]
# The node's owner-only socket is the way in, and the node's user owns it: it runs as `han`, with the read-only
# App's key in a directory only `han` can read (not the executor's write key, which only `han-exec` holds).
User=han
Group=han
ExecStart=/usr/local/bin/han-github run --config /var/lib/han/github/han-github.toml
KillSignal=SIGINT
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
# It writes nothing: a connect() to the node's socket needs no write access to the file system.
ReadOnlyPaths=/var/lib/han/github /var/lib/han/node
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
